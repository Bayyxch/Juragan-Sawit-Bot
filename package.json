{
  "name": "bot-sawit",
  "version": "0.1.0",
  "private": true,
  "description": "Long-term palm farming economy Discord bot.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "14.27.0",
    "dotenv": "18.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
